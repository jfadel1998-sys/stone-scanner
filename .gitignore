# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Build output (regenerated by build_exe.ps1; ~900MB)
build/
dist/

# Generated data (regenerated by crawling; large + changes constantly)
# Globbed, not enumerated: SQLite creates -wal/-shm sidecars for as long as any
# connection is open, so a one-off list keeps missing one and leaving the tree dirty
# (-shm was the gap; the backup's own -wal/-shm are why .bak needs the glob too).
stonescan.db
stonescan.db-*
stonescan.db.bak*
refresh-history.log

# CLIP search-by-photo model (~81MB; fetch with `python -m stonescan.imagesearch --download-model`)
stonescan/models/**/*.onnx
# The app's writable data dir (created next to the exe / project root at runtime).
# Anchored to root so it does NOT swallow bundled source assets in stonescan/data/.
/data/

# Logs
*.log
crawl_*.log
refresh.log

# OS
Thumbs.db
.DS_Store

# Claude Code local/session files
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Stray files at repo root (not project assets): sw.html is a saved page, distributed is an empty leftover
/sw.html
/distributed

# Local Playwright browsers, copied out of the MSIX container so a scheduled task can see them.
.browsers/
