# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Build output (regenerated by build_exe.ps1; ~900MB)
build/
dist/

# Generated data (regenerated by crawling; large + changes constantly)
stonescan.db
stonescan.db-journal
stonescan.db-wal

# CLIP search-by-photo model (~81MB; fetch with `python -m stonescan.imagesearch --download-model`)
stonescan/models/**/*.onnx
# The app's writable data dir (created next to the exe / project root at runtime).
# Anchored to root so it does NOT swallow bundled source assets in stonescan/data/.
/data/

# Logs
*.log
crawl_*.log
refresh.log

# OS
Thumbs.db
.DS_Store

# Claude Code local/session files
.claude/scheduled_tasks.lock
.claude/settings.local.json
